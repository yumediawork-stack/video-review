# --- Frontend (Vite) ---
# Supabase проєкт (публічні значення — безпеку забезпечують RLS та серверна логіка)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Base path GitLab Pages:
#   https://username.gitlab.io/video-review/        → /video-review/
#   власний домен / username.gitlab.io              → /
VITE_BASE_PATH=/video-review/

# Необов язково: примусово ввімкнути mock-режим (демо-дані, без Supabase)
# VITE_USE_MOCK=1

# --- Supabase Edge Functions (налаштовуються НЕ тут, а через supabase secrets):
# supabase secrets set ALLOWED_ORIGINS=http://localhost:5173,https://username.gitlab.io
# supabase secrets set REVIEW_TOKEN_PEPPER=<випадковий рядок, середній рівень секретності>
